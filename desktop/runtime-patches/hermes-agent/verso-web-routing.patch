+def _direct_html_to_text(value: str) -> tuple[str, str]:
+    """Return a compact title/text pair without adding an HTML dependency."""
+    title_match = re.search(r"<title\b[^>]*>(.*?)</title>", value, flags=re.I | re.S)
+    title = unescape(re.sub(r"\s+", " ", title_match.group(1)).strip()) if title_match else ""
+    value = re.sub(r"<head\b[^>]*>.*?</head\s*>", " ", value, flags=re.I | re.S)
+    value = re.sub(
+        r"<(script|style|noscript|svg)\b[^>]*>.*?</\1\s*>",
+        " ",
+        value,
+        flags=re.I | re.S,
+    )
+    value = re.sub(
+        r"</?(?:article|aside|blockquote|br|dd|div|dl|dt|figcaption|figure|footer|"
+        r"h[1-6]|header|hr|li|main|nav|ol|p|pre|section|table|tbody|td|tfoot|th|"
+        r"thead|tr|ul)\b[^>]*>",
+        "\n",
+        value,
+        flags=re.I,
+    )
+    value = re.sub(r"<[^>]+>", " ", value)
+    value = unescape(value).replace("\r", "")
+    lines = [re.sub(r"[ \t\f\v]+", " ", line).strip() for line in value.split("\n")]
+    text = "\n".join(line for line in lines if line)
+    return title, text
+
+
+async def _direct_extract_url(client: httpx.AsyncClient, url: str) -> Dict[str, Any]:
+    """Fetch one public URL directly, rechecking every redirect for SSRF."""
+    current_url = url
+    for _ in range(_DIRECT_FETCH_MAX_REDIRECTS + 1):
+        policy_block = check_website_access(current_url)
+        if policy_block:
+            return {
+                "url": current_url,
+                "title": "",
+                "content": "",
+                "error": policy_block.get("message", "Blocked by website policy"),
+                "blocked_by_policy": policy_block,
+            }
+        if not await async_is_safe_url(current_url):
+            return {
+                "url": current_url,
+                "title": "",
+                "content": "",
+                "error": "Blocked: URL targets a private or internal network address",
+            }
+
+        try:
+            async with client.stream("GET", current_url) as response:
+                if response.status_code in {301, 302, 303, 307, 308}:
+                    location = response.headers.get("location")
+                    if not location:
+                        return {
+                            "url": current_url,
+                            "title": "",
+                            "content": "",
+                            "error": f"HTTP {response.status_code} redirect had no Location header",
+                        }
+                    current_url = normalize_url_for_request(urljoin(current_url, location))
+                    sensitive_query_key = sensitive_query_param_name(current_url)
+                    if sensitive_query_key:
+                        return {
+                            "url": "",
+                            "title": "",
+                            "content": "",
+                            "error": (
+                                "Blocked: redirect URL contains a credential-like "
+                                f"query parameter ({sensitive_query_key})"
+                            ),
+                        }
+                    continue
+
+                response.raise_for_status()
+                body = bytearray()
+                async for chunk in response.aiter_bytes():
+                    body.extend(chunk)
+                    if len(body) > _DIRECT_FETCH_MAX_BYTES:
+                        return {
+                            "url": current_url,
+                            "title": "",
+                            "content": "",
+                            "error": (
+                                "Direct fetch exceeded the 3 MB safety limit; "
+                                "use a configured extraction provider for large documents"
+                            ),
+                        }
+                content_type = response.headers.get("content-type", "").lower()
+                if content_type.startswith(("image/", "audio/", "video/")) or any(
+                    kind in content_type for kind in ("application/pdf", "application/zip", "octet-stream")
+                ):
+                    return {
+                        "url": current_url,
+                        "title": "",
+                        "content": "",
+                        "error": f"Direct fetch does not extract binary content ({content_type or 'unknown type'})",
+                    }
+                encoding = response.encoding or "utf-8"
+                decoded = bytes(body).decode(encoding, errors="replace")
+        except (httpx.HTTPError, UnicodeError) as exc:
+            return {
+                "url": current_url,
+                "title": "",
+                "content": "",
+                "error": f"Direct fetch failed: {exc}",
+            }
+
+        if "html" in content_type or decoded.lstrip().lower().startswith(("<!doctype html", "<html")):
+            title, content = _direct_html_to_text(decoded)
+        else:
+            title, content = "", decoded.strip()
+        return {
+            "url": current_url,
+            "title": title,
+            "content": content,
+            "error": None if content else "Direct fetch returned no readable text",
+        }
+
+    return {
+        "url": current_url,
+        "title": "",
+        "content": "",
+        "error": f"Direct fetch exceeded {_DIRECT_FETCH_MAX_REDIRECTS} redirects",
+    }
+
+
+async def _direct_extract_urls(urls: List[str]) -> List[Dict[str, Any]]:
+    """Credential-free fallback for public, read-only page retrieval."""
+    headers = {
+        "Accept": "text/html,application/xhtml+xml,application/json,text/plain,text/*;q=0.9,*/*;q=0.1",
+        "User-Agent": "Verso/1.0 read-only web fetch",
+    }
+    async with httpx.AsyncClient(
+        follow_redirects=False,
+        timeout=_DIRECT_FETCH_TIMEOUT,
+        headers=headers,
+    ) as client:
+        return await asyncio.gather(*(_direct_extract_url(client, url) for url in urls))
+
 

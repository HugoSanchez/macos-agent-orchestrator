+++ b/tests/tools/test_verso_credential_env.py
@@ -0,0 +1,94 @@
+"""Verso credentials never enter model-authored subprocess environments."""
+
+import os
+from unittest.mock import patch
+
+from tools.code_execution_tool import _scrub_child_env
+from tools.environments.local import (
+    _is_hermes_internal_secret,
+    _make_run_env,
+    _sanitize_subprocess_env,
+    hermes_subprocess_env,
+)
+from tools.mcp_tool import _build_safe_env
+
+
+VERSO_SECRETS = {
+    "VERSO_MANAGED_SESSION_TOKEN": "managed-secret",
+    "VERSO_SIDECAR_AUTH_SECRET": "sidecar-secret",
+    "VERSO_CC_example_TOKEN": "connector-secret",
+    "VERSO_HERMES_API_SERVER_KEY": "gateway-secret",
+}
+VERSO_OPERATIONAL = {
+    "VERSO_RUNTIME_MODE": "managed",
+    "VERSO_BACKEND_URL": "https://backend.example",
+    "VERSO_ORCHESTRATOR_BASE_URL": "http://127.0.0.1:1234",
+}
+BASE_ENV = {"PATH": "/usr/bin:/bin", **VERSO_SECRETS, **VERSO_OPERATIONAL}
+
+
+def test_verso_secret_predicate_is_narrow_and_future_proof():
+    for name in VERSO_SECRETS:
+        assert _is_hermes_internal_secret(name), name
+    assert _is_hermes_internal_secret("VERSO_FUTURE_PASSWORD")
+    assert _is_hermes_internal_secret("VERSO_FUTURE_CREDENTIALS")
+    for name in VERSO_OPERATIONAL:
+        assert not _is_hermes_internal_secret(name), name
+
+
+def test_foreground_terminal_strips_verso_secrets():
+    with patch.dict(os.environ, BASE_ENV, clear=True):
+        result = _make_run_env({})
+    for name in VERSO_SECRETS:
+        assert name not in result
+    for name, value in VERSO_OPERATIONAL.items():
+        assert result.get(name) == value
+
+
+def test_background_and_pty_terminal_strip_verso_secrets():
+    result = _sanitize_subprocess_env(BASE_ENV)
+    for name in VERSO_SECRETS:
+        assert name not in result
+    for name, value in VERSO_OPERATIONAL.items():
+        assert result.get(name) == value
+
+
+def test_passthrough_cannot_reenable_verso_secrets():
+    with patch(
+        "tools.env_passthrough.is_env_passthrough",
+        side_effect=lambda name: name in VERSO_SECRETS,
+    ):
+        result = _sanitize_subprocess_env(BASE_ENV)
+    for name in VERSO_SECRETS:
+        assert name not in result
+
+
+def test_non_terminal_children_strip_verso_secrets_on_both_tiers():
+    for inherit_credentials in (False, True):
+        with patch.dict(os.environ, BASE_ENV, clear=True):
+            result = hermes_subprocess_env(
+                inherit_credentials=inherit_credentials,
+            )
+        for name in VERSO_SECRETS:
+            assert name not in result
+
+
+def test_execute_code_already_strips_verso_secrets():
+    result = _scrub_child_env(BASE_ENV, is_passthrough=lambda _name: False)
+    for name in VERSO_SECRETS:
+        assert name not in result
+
+
+def test_explicit_mcp_environment_still_receives_its_scoped_secret():
+    """The Verso stdio MCP bridge needs its explicitly configured token.
+
+    MCP servers use a separate safe-baseline builder. Confirm the terminal
+    hardening does not remove credentials explicitly scoped to that server.
+    """
+    with patch.dict(os.environ, BASE_ENV, clear=True):
+        result = _build_safe_env({
+            "VERSO_SIDECAR_AUTH_SECRET": "scoped-sidecar-secret",
+        })
+    assert result["VERSO_SIDECAR_AUTH_SECRET"] == "scoped-sidecar-secret"
+    assert "VERSO_MANAGED_SESSION_TOKEN" not in result
+    assert "VERSO_CC_example_TOKEN" not in result

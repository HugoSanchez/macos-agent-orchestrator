diff --git a/tests/tools/test_web_direct_extract.py b/tests/tools/test_web_direct_extract.py
new file mode 100644
index 0000000000000000000000000000000000000000..fffba0b4f5ab6779fafb6afbad041366500a7b36
--- /dev/null
+++ b/tests/tools/test_web_direct_extract.py
@@ -0,0 +1,140 @@
+"""Credential-free web extraction fallback used by Verso."""
+
+import json
+
+import httpx
+import pytest
+
+from tools import web_tools
+from tools.registry import registry
+
+
+def test_web_extract_is_advertised_without_provider_credentials():
+    entry = registry.get_entry("web_extract")
+    assert entry is not None
+    assert entry.check_fn is web_tools.check_web_extract_available
+    assert entry.check_fn() is True
+
+
+@pytest.mark.asyncio
+async def test_direct_extract_returns_readable_html(monkeypatch):
+    async def safe(_url):
+        return True
+
+    monkeypatch.setattr(web_tools, "async_is_safe_url", safe)
+    monkeypatch.setattr(web_tools, "check_website_access", lambda _url: None)
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        assert request.headers.get("cookie") is None
+        assert request.headers.get("authorization") is None
+        return httpx.Response(
+            200,
+            headers={"content-type": "text/html; charset=utf-8"},
+            text=(
+                "<html><head><title>Example &amp; test</title>"
+                "<style>.hidden{display:none}</style></head>"
+                "<body><main><h1>Hello</h1><p>Useful facts.</p>"
+                "<script>steal()</script></main></body></html>"
+            ),
+        )
+
+    async with httpx.AsyncClient(transport=httpx.MockTransport(handler)) as client:
+        result = await web_tools._direct_extract_url(client, "https://example.com/page")
+
+    assert result == {
+        "url": "https://example.com/page",
+        "title": "Example & test",
+        "content": "Hello\nUseful facts.",
+        "error": None,
+    }
+
+
+@pytest.mark.asyncio
+async def test_direct_extract_rechecks_redirect_target(monkeypatch):
+    checked = []
+
+    async def safe(url):
+        checked.append(url)
+        return url != "http://127.0.0.1/private"
+
+    monkeypatch.setattr(web_tools, "async_is_safe_url", safe)
+    monkeypatch.setattr(web_tools, "check_website_access", lambda _url: None)
+
+    def handler(_request: httpx.Request) -> httpx.Response:
+        return httpx.Response(302, headers={"location": "http://127.0.0.1/private"})
+
+    async with httpx.AsyncClient(transport=httpx.MockTransport(handler)) as client:
+        result = await web_tools._direct_extract_url(client, "https://example.com/redirect")
+
+    assert checked == ["https://example.com/redirect", "http://127.0.0.1/private"]
+    assert result["error"] == "Blocked: URL targets a private or internal network address"
+
+
+@pytest.mark.asyncio
+async def test_direct_extract_rechecks_website_policy_after_redirect(monkeypatch):
+    async def safe(_url):
+        return True
+
+    def policy(url):
+        if url == "https://blocked.test/final":
+            return {"rule": "blocked.test", "message": "Blocked by website policy"}
+        return None
+
+    monkeypatch.setattr(web_tools, "async_is_safe_url", safe)
+    monkeypatch.setattr(web_tools, "check_website_access", policy)
+
+    def handler(_request: httpx.Request) -> httpx.Response:
+        return httpx.Response(302, headers={"location": "https://blocked.test/final"})
+
+    async with httpx.AsyncClient(transport=httpx.MockTransport(handler)) as client:
+        result = await web_tools._direct_extract_url(client, "https://example.com/redirect")
+
+    assert result["error"] == "Blocked by website policy"
+    assert result["blocked_by_policy"]["rule"] == "blocked.test"
+
+
+@pytest.mark.asyncio
+async def test_web_extract_uses_direct_fallback_when_no_provider(monkeypatch):
+    async def safe(_url):
+        return True
+
+    async def direct(urls):
+        return [{"url": urls[0], "title": "Direct", "content": "Body", "error": None}]
+
+    monkeypatch.setattr(web_tools, "async_is_safe_url", safe)
+    monkeypatch.setattr(web_tools, "_ensure_web_plugins_loaded", lambda: None)
+    monkeypatch.setattr(web_tools, "_get_extract_backend", lambda: "firecrawl")
+    monkeypatch.setattr(web_tools, "_direct_extract_urls", direct)
+    monkeypatch.setattr("agent.web_search_registry.get_provider", lambda _name: None)
+    monkeypatch.setattr("agent.web_search_registry.get_active_extract_provider", lambda: None)
+
+    result = json.loads(await web_tools.web_extract_tool(["https://example.com"]))
+    assert result["results"][0]["title"] == "Direct"
+    assert result["results"][0]["content"] == "Body"
+
+
+@pytest.mark.asyncio
+async def test_search_only_backend_does_not_disable_direct_extract(monkeypatch):
+    class SearchOnlyProvider:
+        display_name = "Search only"
+
+        def supports_extract(self):
+            return False
+
+    async def safe(_url):
+        return True
+
+    async def direct(urls):
+        return [{"url": urls[0], "title": "Direct", "content": "Body", "error": None}]
+
+    monkeypatch.setattr(web_tools, "async_is_safe_url", safe)
+    monkeypatch.setattr(web_tools, "_ensure_web_plugins_loaded", lambda: None)
+    monkeypatch.setattr(web_tools, "_get_extract_backend", lambda: "ddgs")
+    monkeypatch.setattr(web_tools, "_direct_extract_urls", direct)
+    monkeypatch.setattr(
+        "agent.web_search_registry.get_provider", lambda _name: SearchOnlyProvider()
+    )
+    monkeypatch.setattr("agent.web_search_registry.get_active_extract_provider", lambda: None)
+
+    result = json.loads(await web_tools.web_extract_tool(["https://example.com"]))
+    assert result["results"][0]["title"] == "Direct"

+class LiveMCPStatusTest(unittest.IsolatedAsyncioTestCase):
+    async def test_disconnected_sessions_cannot_advertise_stale_registered_tools(self):
+        import json
+        from types import SimpleNamespace
+        from unittest.mock import Mock
+        tasks = {
+            "live": SimpleNamespace(session=object(), _task=Mock(done=lambda: False), _registered_tool_names=["live_tool"]),
+            "retrying": SimpleNamespace(session=None, _task=Mock(done=lambda: False), _registered_tool_names=["stale_tool"]),
+            "stopped": SimpleNamespace(session=object(), _task=Mock(done=lambda: True), _registered_tool_names=["dead_tool"]),
+        }
+        with patch.object(mcp_tool, "_servers", tasks):
+            response = await verso_mcp_oauth.handle_registered_tools(SimpleNamespace(_check_auth=lambda req: None), None)
+        self.assertEqual(json.loads(response.text)["servers"], {"live": ["live_tool"], "retrying": [], "stopped": []})
+
+
+if __name__ == "__main__":
+    unittest.main()
